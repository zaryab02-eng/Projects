# OPTIONAL. Fill these in so the website shows what is added in the Admin app.
# Copy this file to ".env" first. Leave empty to use the built-in sample data.
# See README, "Connecting the admin app".

# Same Firebase project as the admin app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# THIS website's id. One admin app can manage many websites; each has its own id.
# Must match the siteId given to the admin login (e.g. natusz)
VITE_SITE_ID=natusz
