# Copy this file to ".env" and fill in your values (see README, section 1 and 2).
# Firebase: Project settings > Your apps > Web app > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (free image hosting): cloud name + an UNSIGNED upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Address of the public website (for the "View website" button)
VITE_SITE_URL=https://your-website.com
